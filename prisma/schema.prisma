// ReliefAI Prisma Schema for PostgreSQL
// Production-grade disaster response, multi-role auth, and coordination system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  citizen
  rescue_team
  ngo
  government
  admin
  volunteer
  commander
  responder
  super_admin
}

enum VerificationTokenType {
  email_verification
  password_reset
  login_verify
  email_change
  activation
}

enum NGOApplicationStatus {
  pending
  approved
  rejected
}

enum DisasterType {
  flood
  earthquake
  wildfire
  hurricane
  industrial
  medical
  environmental
}

enum SeverityLevel {
  critical
  high
  moderate
  low
}

enum IncidentStatus {
  active
  contained
  resolved
}

enum DataSourceType {
  historical
  live
  forecast
  demo
}

enum SOSPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SOSStatus {
  pending
  triaged
  dispatched
  assigned
  in_progress
  rescued
  resolved
  cancelled
}

enum ShelterStatus {
  open
  nearing_capacity
  full
  closed
}

enum SupplyCategory {
  medical
  rations
  water
  shelter_gear
  vehicles
  power
  tents
  generators
  infant_kits
}

enum SupplyStatus {
  adequate
  low
  critical
}

enum ResponderType {
  medical_unit
  swift_water
  search_rescue
  logistics
  drone_recon
}

enum TeamStatus {
  available
  dispatched
  en_route
  on_scene
  off_duty
}

model User {
  id                  String    @id @default(cuid())
  name                String
  displayName         String?
  email               String    @unique
  passwordHash        String?
  role                UserRole  @default(citizen)
  isEmailVerified     Boolean   @default(false)
  avatarUrl           String?
  organization        String?
  badgeNumber         String?
  assignedTeamId      String?
  phone               String?
  assignedZone        String?
  skills              String[]  @default([])
  location            Json?
  failedLoginAttempts Int       @default(0)
  lockoutUntil        String?
  status              String    @default("approved")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  EmailVerificationToken[]

  @@index([role])
  @@index([assignedTeamId])
  @@index([status])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  email     String?
  token     String    @unique
  otp       String?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([otp])
}

model EmailVerificationToken {
  id        String                @id @default(cuid())
  userId    String
  email     String?
  token     String?
  otp       String
  type      VerificationTokenType @default(email_verification)
  attempts  Int                   @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([otp])
}

model NGOApplication {
  id                   String               @id @default(cuid())
  organizationName     String
  registrationNumber   String               @unique
  focalPersonName      String
  focalPersonEmail     String
  focalPersonPhone     String
  website              String?
  hqAddress            String
  operationalDistricts String[]             @default([])
  reliefCapabilities   String[]             @default([])
  documentName         String?
  documentData         String?              @db.Text
  status               NGOApplicationStatus @default(pending)
  adminNotes           String?              @db.Text
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status])
  @@index([focalPersonEmail])
}

model DisasterIncident {
  id                            String         @id
  title                         String
  banglaTitle                   String?
  type                          DisasterType
  severity                      SeverityLevel
  status                        IncidentStatus @default(active)
  dataSource                    DataSourceType @default(demo)
  isDemo                        Boolean        @default(false)
  citation                      Json?
  location                      Json
  affectedPopulation            Int            @default(0)
  casualtiesReported            Int            @default(0)
  respondersDeployed            Int            @default(0)
  reportedAt                    DateTime       @default(now())
  occurredAt                    DateTime?
  description                   String         @db.Text
  recommendedEvacuationRadiusKm Float?
  activeHazards                 String[]       @default([])
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  sosRequests                   SOSRequest[]

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([dataSource])
}

model SOSRequest {
  id                 String             @id
  reporterName       String
  phone              String
  contactPhone       String?
  disasterId         String?
  location           Json
  urgencyScore       Float              @default(50)
  priority           SOSPriority        @default(MEDIUM)
  status             SOSStatus          @default(pending)
  details            String             @db.Text
  description        String?            @db.Text
  imageUrl           String?
  videoUrl           String?
  voiceNoteUrl       String?
  trappedCount       Int                @default(0)
  injuriesCount      Int                @default(0)
  specialNeeds       String[]           @default([])
  needsBoat          Boolean            @default(false)
  needsMedical       Boolean            @default(false)
  needsFoodWater     Boolean            @default(false)
  assignedTeamId     String?
  assignedTeamName   String?
  aiTriageSummary    String?            @db.Text
  dispatchEtaMinutes Int?
  aiDamageAssessment Json?
  aiSeverity         Json?
  assignedTo         Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  disaster           DisasterIncident?  @relation(fields: [disasterId], references: [id], onDelete: SetNull)

  @@index([priority])
  @@index([status])
  @@index([urgencyScore])
  @@index([disasterId])
}

model Shelter {
  id               String        @id
  name             String
  address          String
  lat              Float
  lng              Float
  capacity         Int
  currentOccupancy Int           @default(0)
  hasMedical       Boolean       @default(false)
  hasFood          Boolean       @default(true)
  hasWater         Boolean       @default(true)
  hasPower         Boolean       @default(false)
  isPetFriendly    Boolean       @default(false)
  hasSupplies      Boolean       @default(true)
  contactPhone     String?
  contactNumber    String?
  managedByNGO     String?
  status           ShelterStatus @default(open)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
}

model SupplyItem {
  id                String         @id
  name              String
  category          SupplyCategory
  quantity          Int
  unit              String
  warehouseLocation String
  status            SupplyStatus   @default(adequate)
  threshold         Int            @default(50)
  allocated         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([category])
  @@index([status])
}

model ResponderTeam {
  id                String        @id
  name              String
  leadName          String
  type              ResponderType
  membersCount      Int           @default(4)
  status            TeamStatus    @default(available)
  currentIncidentId String?
  assignedSOSId     String?
  currentLocation   Json
  radioFreq         String
  equipment         String[]      @default([])
  lastCheckIn       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([type])
  @@index([status])
}

model AidDonation {
  id             String   @id
  donorName      String
  donorEmail     String?
  amount         Float
  currency       String   @default("BDT")
  allocatedCause String
  impactMetric   String
  txHash         String
  channel        String?
  isVerified     Boolean  @default(true)
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())
}

model RescueTeamAuditLog {
  id             String   @id @default(cuid())
  operatorId     String
  operatorEmail  String
  action         String
  targetUserId   String
  previousTeamId String?
  newTeamId      String?
  reason         String?
  timestamp      DateTime @default(now())

  @@index([targetUserId])
  @@index([operatorId])
}
