# ==============================================================================
# ReliefAI Bangladesh - Unified Environment Configuration Template
# ==============================================================================
# The platform is engineered to operate out of the box with resilient offline
# simulations and in-memory caches. Fill in the keys below to activate live
# cloud microservices, MongoDB Atlas persistence, multimodal AI, and Google Maps.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Or Local: mongodb://127.0.0.1:27017/reliefai
# When provided, all models (Users, Disasters, SOS, Shelters, Supplies, Responders, Donations)
# persist to MongoDB with automatic seed initialization. If left blank, ReliefAI runs
# flawlessly in high-speed in-memory mode.
MONGODB_URI=mongodb+srv://reliefai_admin:your_secure_password@cluster0.mongodb.net/reliefai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY (Production-Grade Dual-Token System)
# ------------------------------------------------------------------------------
# In production, both JWT_ACCESS_SECRET (or JWT_SECRET) and JWT_REFRESH_SECRET
# are strictly mandatory, distinct from each other, and must each be at least 32 characters long.
# Example generator: openssl rand -hex 32
JWT_ACCESS_SECRET=your_32_plus_character_secure_access_secret_key_here
JWT_SECRET=your_32_plus_character_secure_access_secret_key_here
JWT_REFRESH_SECRET=your_32_plus_character_distinct_refresh_secret_key_here

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Multimodal Damage Vision, Audio Transcription, & Triage)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
# Used for real-time SOS urgency scoring, damage assessment, and triage advisory.
# NOTE: This is a server-side only secret. Do NOT use NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere1234567890

# ------------------------------------------------------------------------------
# 4. OPENAI API (Optional Secondary LLM Fallback Provider)
# ------------------------------------------------------------------------------
# Obtain from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere1234567890

# ------------------------------------------------------------------------------
# 5. GOOGLE MAPS API (Tactical Satellite & Terrain Tile HUD)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure Maps JavaScript API is enabled. When omitted, ReliefAI renders its custom
# SVG-powered Bangladesh Tactical Vector Map.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSyYourGoogleMapsApiKeyHere1234567890

# ------------------------------------------------------------------------------
# 6. FIREBASE CLOUD SERVICES (Live Storage, Field Photos, & Telemetry)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Your Apps (Web):
# https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=reliefai-bangladesh.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reliefai-bangladesh
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=reliefai-bangladesh.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ------------------------------------------------------------------------------
# 7. REGIONAL DISASTER MESH & INCIDENT COMMAND (Bangladesh National Grid)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_OPERATIONAL_SECTOR=BANGLADESH_NATIONAL_GRID
NEXT_PUBLIC_MESH_NODE_ID=BD_DHAKA_CENTRAL_EOC
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 8. DISTRIBUTED RATE LIMITING & TRUSTED PROXY CONFIGURATION (Upstash Redis REST)
# ------------------------------------------------------------------------------
# In production, ReliefAI requires a distributed rate limiting store (Upstash Redis)
# to enforce shared rate limits across serverless instances and prevent fail-open
# vulnerabilities on public mutation endpoints (e.g., POST /api/sos, POST /api/donations).
# If unconfigured or unreachable in production, the rate limiter fails closed safely (503).
# In development and local testing, an in-memory store is used as a fallback.
#
# Obtain credentials from Upstash Console (https://console.upstash.com/):
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# TRUST_PROXY_HEADERS:
# Set to 'true' ONLY when ReliefAI is deployed behind a verified reverse proxy
# (e.g., Cloudflare, AWS ALB, Nginx, Vercel Edge) configured to strip/sanitize
# client-supplied forwarding headers before reaching the application.
# When 'false' or omitted, client-supplied X-Forwarded-For and X-Real-IP headers
# are strictly ignored to prevent client IP spoofing and rate-limit evasion.
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------------------
# 9. INITIAL ADMIN BOOTSTRAP (Secure One-Time Setup for New Deployments)
# ------------------------------------------------------------------------------
# In production, default test accounts are disabled by default.
# Use these environment variables to bootstrap the initial root administrator.
#
# ADMIN_BOOTSTRAP_SECRET: Required to enable the one-time /api/auth/bootstrap API endpoint.
# Must be at least 16 characters. Example: openssl rand -hex 24
ADMIN_BOOTSTRAP_SECRET=your_32_character_admin_bootstrap_secret_token_here

# For CLI bootstrap (npm run bootstrap:admin):
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.gov.bd
BOOTSTRAP_ADMIN_PASSWORD=YourSecureAdminPassword123!
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 10. SHOWCASE EVALUATION MODE (Dedicated Staging/Demo Environments ONLY)
# ------------------------------------------------------------------------------
# SHOWCASE_MODE activates the evaluation mode with predefined designated demo roles.
# ENVIRONMENT ISOLATION NOTICE:
# SHOWCASE_MODE must strictly run in a dedicated staging/showcase deployment with
# demo accounts only. It must NEVER be enabled on live multi-tenant production
# deployments containing real citizens, responders, or government data.
# When enabled, a strict default-deny mutation policy locks down all persistent
# write APIs (SOS dispatch, donations, admin provisioning, password changes, etc.)
# while permitting session auth (login/logout/refresh) and ephemeral AI synthesis.
# Default: false
SHOWCASE_MODE=false
