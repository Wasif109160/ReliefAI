# ==============================================================================
# ReliefAI Bangladesh - Production Environment Configuration Reference
# ==============================================================================
# Copy this file to .env.local for local development or input into Render/Vercel
# settings for production deployments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY DATABASE CONFIGURATION (PostgreSQL / Prisma - Preferred)
# ------------------------------------------------------------------------------
# Required for production persistence of Users, Incidents, SOS, Shelters, Supplies.
# Render automatically injects this when using the Managed PostgreSQL service.
# For local dev: postgresql://postgres:postgres@localhost:5432/reliefai?schema=public
# For Supabase/Neon: postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://reliefai_user:your_secure_db_password@dpg-host-a.singapore-postgres.render.com/reliefai

# ------------------------------------------------------------------------------
# 2. SECONDARY DATABASE (MongoDB - Optional / Legacy Migration)
# ------------------------------------------------------------------------------
# Left blank when using PostgreSQL with Prisma.
# MONGODB_URI=mongodb+srv://reliefai_admin:your_password@cluster0.mongodb.net/reliefai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY (Production Dual-Token System)
# ------------------------------------------------------------------------------
# Both secrets MUST be distinct, at least 32 characters, and cryptographically random.
# Generate via: openssl rand -hex 32
JWT_ACCESS_SECRET=your_32_plus_character_secure_access_secret_key_here
JWT_SECRET=your_32_plus_character_secure_access_secret_key_here
JWT_REFRESH_SECRET=your_32_plus_character_distinct_refresh_secret_key_here

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS) & NETWORKING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins that can communicate with this backend.
# In decoupled setups (Frontend on Vercel, Backend on Render), set this to your Vercel URL.
ALLOWED_ORIGINS=https://reliefai.vercel.app,http://localhost:3000

# Canonical Application & Public API URLs
NEXT_PUBLIC_APP_URL=https://reliefai.vercel.app
NEXT_PUBLIC_API_URL=https://reliefai-backend.onrender.com

# Reverse Proxy Trust (Set to 'true' behind Render, Cloudflare, or Vercel Edge)
TRUST_PROXY_HEADERS=true

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED RATE LIMITING (Upstash Redis REST)
# ------------------------------------------------------------------------------
# Required in production to enforce distributed rate limits and protect SOS/Donation endpoints.
# Create a free Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ------------------------------------------------------------------------------
# 6. MULTIMODAL AI ENGINES (Google Gemini & OpenAI)
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Flash (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere1234567890

# Optional fallback provider (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere1234567890

# ------------------------------------------------------------------------------
# 7. GOOGLE MAPS HUD & SATELLITE TILES
# ------------------------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials (Enable Maps JavaScript API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSyYourGoogleMapsApiKeyHere1234567890

# ------------------------------------------------------------------------------
# 8. FIREBASE CLOUD SERVICES (Live Storage & Telemetry)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=reliefai-bangladesh.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reliefai-bangladesh
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=reliefai-bangladesh.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ------------------------------------------------------------------------------
# 9. DISASTER MESH GRID & COMMAND SYSTEM
# ------------------------------------------------------------------------------
NEXT_PUBLIC_OPERATIONAL_SECTOR=BANGLADESH_NATIONAL_GRID
NEXT_PUBLIC_MESH_NODE_ID=BD_DHAKA_CENTRAL_EOC

# ------------------------------------------------------------------------------
# 10. ONE-TIME PRODUCTION ADMINISTRATOR BOOTSTRAP
# ------------------------------------------------------------------------------
# Required to execute POST /api/auth/bootstrap or run scripts/bootstrap-admin.ts
ADMIN_BOOTSTRAP_SECRET=your_32_character_admin_bootstrap_secret_token_here
BOOTSTRAP_ADMIN_EMAIL=admin@relief.ai
BOOTSTRAP_ADMIN_PASSWORD=YourSecureAdminPassword123!
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 11. POLICY FLAGS
# ------------------------------------------------------------------------------
SHOWCASE_MODE=false
